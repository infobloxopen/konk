      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS_UID}" },
          "expr": "histogram_quantile(0.99, sum by (le, pod) (rate(etcd_disk_backend_commit_duration_seconds_bucket{namespace=\"$namespace\", pod=~\"$pod\"}[$__rate_interval])))",
          "legendFormat": "{{pod}}",
          "refId": "A"
